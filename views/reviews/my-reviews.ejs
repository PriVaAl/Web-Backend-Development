<h1>My Reviews</h1>
<%- messages() %>

<% if (reviews && reviews.length > 0) { %>
  <div class="reviews-list">
    <% reviews.forEach(review => { %>
      <div class="review-card">
        <h2>
          <a href="/inv/detail/<%= review.inv_id %>">
            <%= review.inv_year %> <%= review.inv_make %> <%= review.inv_model %>
          </a>
        </h2>
        <div class="star-display">
          <% for(let i = 1; i <= 5; i++) { %>
            <span class="<%= i <= review.review_rating ? 'star-filled' : 'star-empty' %>">★</span>
          <% } %>
          <span>(<%= review.review_rating %>/5)</span>
        </div>
        <p><%= review.review_text %></p>
        <small>Posted: <%= new Date(review.review_date).toLocaleDateString() %></small>
        <a href="/reviews/delete/<%= review.review_id %>" 
           class="btn-delete"
           onclick="return confirm('Are you sure you want to delete this review?')">
          Delete Review
        </a>
      </div>
    <% }) %>
  </div>
<% } else { %>
  <p>You have not written any reviews yet. 
    Browse our <a href="/">inventory</a> to find vehicles to review!</p>
<% } %>

<a href="/account/">Back to Account Management</a>