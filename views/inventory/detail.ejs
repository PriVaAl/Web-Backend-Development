<!-- Content Heading -->
<% if (title) { %>
<h1><%= title %></h1>
<% } else {
  res.redirect('/')
} %>

<!-- Message Block -->
<%# messages() %>

<!-- Vehicle Detail Display -->
<%- detail %>

<!-- Reviews Section for Enhacement project week 6 -->
 <section class="reviews-section">
  <h2>Customer Review</h2>
  <% if (locals.avgRating && locals.avgRating.review_count > 0) { %>
    <div class="avg-rating">
      <span class="rating-number"><%= locals.avgRating.avg_rating %></span>
      <span>/5</span>
      <span>(<%= locals.avgRating.review_count %> reviews)</span>
    </div>
  <% } else { %>
    <p>No reviews yet. Be the first to review!</p>
  <% } %>
  <% if (locals.reviews && locals.reviews.length > 0) { %>
    <% locals.reviews.forEach(review => { %>
      <div class="review-card">
        <div class="star-display">
          <% for(let i = 1; i <= 5; i++) { %>
            <span class="<%= i <= review.review_rating ? 'star-filled' : 'star-empty' %>">★</span>
          <% } %>
        </div>
        <p><%= review.review_text %></p>
        <small>By <%= review.account_firstname %> <%= review.account_lastname %> 
          on <%= new Date(review.review_date).toLocaleDateString() %></small>
      </div>
    <% }) %>
  <% } %>

  <% if (locals.loggedin) { %>
    <a href="/reviews/add/<%= locals.inv_id %>" class="btn-review">
      ★ Write a Review
    </a>
  <% } else { %>
    <p><a href="/account/login">Login</a> to write a review.</p>
  <% } %>

 </section>