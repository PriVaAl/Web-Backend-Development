<h1>Delete <%= locals.inv_make %> <%= locals.inv_model %></h1>
<%- messages() %>
<% if (errors) { %>
  <ul class="notice">
    <% errors.array().forEach(error => { %>
      <li><%= error.msg %></li>
    <% }) %>
  </ul>
<% } %>
<p class="delete-confirm-msg">Confirm Deletion - The deletion is permanent.</p>
<form class="delete-form" action="/inv/delete" method="post">
  <fieldset>
    <label for="invMake">Make</label>
    <input type="text" id="invMake" readonly
    <% if(locals.inv_make) { %> value="<%= locals.inv_make %>"<% } %>>

    <label for="invModel">Model</label>
    <input type="text" id="invModel" readonly
    <% if(locals.inv_model) { %> value="<%= locals.inv_model %>"<% } %>>

    <label for="invPrice">Price</label>
    <input type="text" id="invPrice" readonly
    <% if(locals.inv_price) { %> value="<%= locals.inv_price %>"<% } %>>

    <label for="invYear">Year</label>
    <input type="text" id="invYear" readonly
    <% if(locals.inv_year) { %> value="<%= locals.inv_year %>"<% } %>>

    <input type="hidden" name="inv_id"
    <% if(locals.inv_id) { %> value="<%= locals.inv_id %>"<% } %>>

    <button type="submit">Delete</button>
  </fieldset>
</form>
<a href="/inv/">Back to Management</a>  